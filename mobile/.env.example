# URL da API (inclui o prefixo /api). Embutida no app no momento do build.
#   Emulador Android + backend local: http://10.0.2.2:8000/api
#   Celular físico na mesma rede:      http://<IP-do-computador>:8000/api
#   Produção (Vercel):                 https://<seu-dominio>/api
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api

# Identificadores das lojas (opcional)
ANDROID_PACKAGE=br.com.virgilio.app
IOS_BUNDLE_ID=br.com.virgilio.app

# Notificações push (lembretes de prova de vida e alertas para quem é Virgílio).
# Sem elas o app funciona e ainda agenda um lembrete local no aparelho, mas não recebe alertas.
#   EAS_PROJECT_ID:       ID do projeto em expo.dev (npx eas-cli@latest init mostra o valor)
#   GOOGLE_SERVICES_JSON: caminho do google-services.json do Firebase (Android/FCM), fora do git
EAS_PROJECT_ID=
GOOGLE_SERVICES_JSON=
