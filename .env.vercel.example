# ============================================================================
# Virgílio — variáveis do projeto Vercel (serviços "backend" e "frontend", ver vercel.json)
# Cole este conteúdo em Settings → Environment Variables (a Vercel aceita colar um .env inteiro).
# As variáveis valem para os dois serviços. NUNCA faça commit dos valores reais:
# preencha uma cópia em .env.vercel.local (ignorada pelo git).
# ============================================================================

# Obrigatório "prod" em URL pública.
ENV=prod

# Postgres: a integração Neon da Vercel (Storage → Neon) cria DATABASE_URL (pooled) e
# DATABASE_URL_UNPOOLED automaticamente. Não preencha à mão; ao colar este modelo, apague esta linha.
# DATABASE_URL=postgresql://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/virgilio?sslmode=require

# Mínimo 32 caracteres. Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Chave da criptografia das instruções (recomendado: separada do JWT_SECRET).
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Defina uma vez e NÃO troque: as instruções já gravadas ficariam ilegíveis.
INSTRUCTIONS_KEY=

# Domínio de produção (sem barra no final). Vai nos links dos e-mails.
CORS_ORIGINS=https://virgilio.vercel.app
FRONTEND_URL=https://virgilio.vercel.app

# E-mail (SMTP) — mesma configuração do promoAE (copie os SMTP_* de lá). ESSENCIAL: é por ele que os Virgílios sem o app recebem os alertas.
# Qualquer provedor serve (Brevo, Resend, Gmail com senha de app). Na Vercel use a porta 587 ou 465.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Virgílio <seu-endereco@gmail.com>
# Contato exibido no site (o mesmo do promoAE)
SUPPORT_EMAIL=anonimizae@proton.me

# Download do app Android no site: o APK fica na release mais recente do repositório no GitHub
# (este link sempre aponta para a última). Vazio = botão oculto.
ANDROID_APK_URL=https://github.com/mateus-n00b/virgilio/releases/latest/download/virgilio.apk

# Varredura (lembretes e alertas). O Vercel Cron chama /api/internal/sweep com este segredo.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
CRON_SECRET=

# Só se a "enhanced push security" estiver ativa no painel do EAS (expo.dev)
EXPO_ACCESS_TOKEN=

# Ciclo padrão das contas novas (cada pessoa ajusta no app) e limites
DEFAULT_INTERVAL_DAYS=3
DEFAULT_GRACE_DAYS=1
MAX_GUARDIANS=5
