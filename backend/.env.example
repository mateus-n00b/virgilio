# dev | prod  (em dev, sem SMTP, o link de redefinição de senha aparece na resposta da API)
ENV=dev
DATABASE_URL=postgresql+psycopg://virgilio:virgilio@localhost:5432/virgilio
CORS_ORIGINS=http://localhost:3000
# Endereço do site: vai nos links dos e-mails (convite, alerta, confirmação em um clique)
FRONTEND_URL=http://localhost:3000
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-este-segredo

# Chave da criptografia das instruções. Vazia = derivada do JWT_SECRET.
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Defina uma vez e não troque: as instruções já gravadas deixariam de ser legíveis.
INSTRUCTIONS_KEY=

# Ciclo de prova de vida: valores iniciais de cada conta (a pessoa ajusta no app) e limites
DEFAULT_INTERVAL_DAYS=2
DEFAULT_GRACE_DAYS=1
MAX_INTERVAL_DAYS=30
MAX_GRACE_DAYS=14
MAX_GUARDIANS=5

# E-mail (SMTP), mesma configuração do promoAE: lembretes, convites e alertas aos Virgílios.
# Sem ele, só há push no app. Qualquer provedor serve (Brevo, Resend, Gmail com senha de app).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Contato exibido no site (Termos, Privacidade e ajuda)
SUPPORT_EMAIL=anonimizae@proton.me

# Varredura periódica (lembretes e alertas): python -m app.cli sweep, ou GET /api/internal/sweep
# com Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
# Só se a "enhanced push security" estiver ativa no painel do EAS (expo.dev)
EXPO_ACCESS_TOKEN=
